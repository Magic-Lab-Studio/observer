# Observer backend
# SQLite is suitable for a local single-node evaluation. Use PostgreSQL for a
# shared deployment.
DATABASE_URL=sqlite+aiosqlite:///./observatory.db

# Leave empty only for local development. Set a strong random value before
# exposing the API outside a trusted machine.
OBSERVATORY_API_KEY=
# The REST API and /ws/live both require it when set. The dashboard's dev/preview
# proxy (dashboard/vite.config.ts) adds it server-side when the dashboard process
# has OBSERVATORY_API_KEY in its environment; the browser never sees it.

# Days of traces to keep (spans, evaluations and ingestion receipts go with them).
# 0 keeps everything. Purged at startup and every OBSERVATORY_RETENTION_INTERVAL_SEC.
OBSERVATORY_RETENTION_DAYS=0
OBSERVATORY_RETENTION_INTERVAL_SEC=21600

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# slowapi-compatible limits.
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_BATCH=120/minute
RATE_LIMIT_MANITOS_BATCH=120/minute

# Optional LLM-as-Judge configuration. With no API key, qualitative model
# evaluation is skipped and deterministic evaluation remains available.
# Default when unset: gpt-4o.
OBSERVATORY_JUDGE_MODEL=gpt-4o
OPENAI_API_KEY=

# Capture modes (docs/privacy.md): metadata | redacted | full. OBSERVATORY_CAPTURE_DEFAULT overrides every
# project; OBSERVATORY_OTLP_CAPTURE is the default for the OTLP receiver (metadata).
# OBSERVATORY_CAPTURE_DEFAULT=
# OBSERVATORY_OTLP_CAPTURE=metadata

# Background loops (1 = on). OBSERVATORY_ALERTS_DEFAULTS seeds the default alert rules.
# OBSERVATORY_ALERTS=1
# OBSERVATORY_ALERTS_DEFAULTS=1
# OBSERVATORY_ALERT_INTERVAL_SEC=60
# OBSERVATORY_AUTO_EVAL=1
# OBSERVATORY_AUTO_EVAL_INTERVAL_SEC=60
# OBSERVATORY_AUTO_EVAL_DAYS=7
# OBSERVATORY_PROVIDERS_SNAPSHOT=

# Request limits (docs/security.md).
# OBSERVATORY_MAX_BODY_BYTES=
# RATE_LIMIT_OTLP=600/minute

# MCP server (observer-mcp): whether tool results may include span input/output.
# OBSERVER_MCP_CONTENT=0

# Dashboard dev/preview proxy and compose (dashboard/vite.config.ts, docker-compose.yml).
# OBSERVER_API_URL=http://localhost:8000
# OBSERVER_DASHBOARD_HOST=127.0.0.1
# OBSERVER_BIND=127.0.0.1
# POSTGRES_PASSWORD=   # required by the compose stack
